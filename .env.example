# Cloudflare Turnstile (anti-spam formulaire de contact)
# Clé publique — exposée côté client
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Clé secrète — serveur uniquement, ne jamais exposer au client
TURNSTILE_SECRET_KEY=

# Destinataire des demandes de contact (env pour l'instant ; BDD plus tard)
CONTACT_EMAIL=
# Expéditeur Resend (domaine vérifié, ex. noreply@kyira-energies.com)
# Pour les tests : onboarding@resend.dev
RESEND_FROM_EMAIL=

# Resend — clé API serveur uniquement, ne jamais exposer au client
# https://resend.com/api-keys
RESEND_API_KEY=

# PostHog (mesure d'audience — activé uniquement après consentement)
# Clé projet — exposée côté client
NEXT_PUBLIC_POSTHOG_KEY=
# Host / reverse proxy PostHog (conserver la valeur configurée en production, ex. Netlify)
NEXT_PUBLIC_POSTHOG_HOST=
