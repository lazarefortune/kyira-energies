# Cloudflare Turnstile (anti-spam formulaire de contact)
# Clé publique — exposée côté client
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Clé secrète — serveur uniquement, ne jamais exposer au client
TURNSTILE_SECRET_KEY=

# Destinataire des demandes de contact (env pour l'instant ; BDD plus tard)
CONTACT_TO_EMAIL=
# Expéditeur Resend (domaine vérifié, ex. noreply@votredomaine.fr)
# Pour les tests : onboarding@resend.dev
CONTACT_FROM_EMAIL=

# Resend — clé API serveur uniquement, ne jamais exposer au client
# https://resend.com/api-keys
RESEND_API_KEY=
